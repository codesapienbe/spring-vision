<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.codesapienbe.springvision</groupId>
    <artifactId>parent</artifactId>
    <version>0.0.7</version>
  </parent>

  <artifactId>core</artifactId>
  <name>Spring Vision -> Core</name>
  <description>Core domain classes and interfaces for Spring Vision</description>

  <properties>
    <!-- pytorch.version and pytorch.classifier are inherited from the root pom
         (root sets default linux-x86_64 + OS-detection profiles override per host). -->

    <!-- Models are now loaded automatically from HuggingFace via DJL's Criteria API -->
    <!-- Directory where build-time downloaded models are stored -->
    <models.directory>${project.basedir}/models</models.directory>
  </properties>

  <pluginRepositories>
    <pluginRepository>
      <id>central</id>
      <name>Maven Central</name>
      <url>https://repo.maven.apache.org/maven2</url>
    </pluginRepository>
  </pluginRepositories>

  <dependencies>
    <!-- Spring Boot Starter -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- Spring Boot Actuator for health indicators -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- SLF4J API -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Jackson Databind for JSON parsing in REST client -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- JUnit 5 for testing -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- JUnit 5 Engine -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- JUnit Platform Suite API for test suites -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite-api</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- JUnit Platform Suite Engine for running test suites -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite-engine</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Spring Boot Test Starter -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Micrometer for metrics -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <version>1.12.0</version>
    </dependency>

    <!-- Micrometer registry -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <version>1.12.0</version>
    </dependency>

    <!-- Logback JSON encoder for structured logging -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>7.4</version>
    </dependency>

    <!-- Apache Tika: the text and metadata of PDF and Microsoft Office documents (PDF via PDFBox).
         Scanned pages still go through Tesseract below. commons-logging is excluded: Spring's
         spring-jcl provides the same API. -->
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-parser-pdf-module</artifactId>
      <version>${tika.version}</version>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-parser-microsoft-module</artifactId>
      <version>${tika.version}</version>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- ZXing barcode detection -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.1</version>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>3.5.1</version>
    </dependency>
    <!-- Metadata Extractor for EXIF data -->
    <dependency>
      <groupId>com.drewnoakes</groupId>
      <artifactId>metadata-extractor</artifactId>
      <version>2.19.0</version>
    </dependency>

    <!-- ONNX Runtime (used by emotion detection and most other DJL models below). Artifact
         switches between the CPU and CUDA build via the root pom's onnxruntime.artifact
         property — see the gpu Maven profile. -->
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>${onnxruntime.artifact}</artifactId>
    </dependency>

    <!-- Tesseract 5.5 OCR (bytedeco JavaCPP presets, used under Apache-2.0; Tesseract itself is
         Apache-2.0, Leptonica BSD-2-Clause). Natives for the build host's platform; the language
         data is bundled by the download-models profile, so no host install is needed. -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>tesseract</artifactId>
      <version>${tesseract.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>tesseract</artifactId>
      <version>${tesseract.version}</version>
      <classifier>${opencv.classifier}</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>leptonica</artifactId>
      <version>${leptonica.version}</version>
      <classifier>${opencv.classifier}</classifier>
      <scope>runtime</scope>
    </dependency>

    <!-- OpenCV 4.14 (bytedeco JavaCPP presets, used under Apache-2.0). The Java API jars
         plus the natives for the build host's platform (opencv.classifier, root pom). -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>opencv</artifactId>
      <version>${opencv.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>opencv</artifactId>
      <version>${opencv.version}</version>
      <classifier>${opencv.classifier}</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>openblas</artifactId>
      <version>${openblas.version}</version>
      <classifier>${opencv.classifier}</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
      <version>${javacpp.version}</version>
      <classifier>${opencv.classifier}</classifier>
      <scope>runtime</scope>
    </dependency>

    <!-- DJL API (default backend) -->
    <dependency>
      <groupId>ai.djl</groupId>
      <artifactId>api</artifactId>
    </dependency>

    <!-- DJL Model Zoo -->
    <dependency>
      <groupId>ai.djl</groupId>
      <artifactId>model-zoo</artifactId>
    </dependency>

    <!-- DJL PyTorch Engine (for face detection and recognition models) -->
    <dependency>
      <groupId>ai.djl.pytorch</groupId>
      <artifactId>pytorch-engine</artifactId>
    </dependency>

    <!-- DJL PyTorch Model Zoo -->
    <dependency>
      <groupId>ai.djl.pytorch</groupId>
      <artifactId>pytorch-model-zoo</artifactId>
    </dependency>

    <!-- Add an explicit platform-specific PyTorch native library to avoid runtime JNI download in containers.
         Classifier is auto-selected by the OS-detection profiles in the root pom; the artifact
         itself (CPU vs CUDA build) switches via the root pom's pytorch.native.artifact
         property — see the gpu Maven profile. -->
    <dependency>
      <groupId>ai.djl.pytorch</groupId>
      <artifactId>${pytorch.native.artifact}</artifactId>
      <version>${pytorch.version}</version>
      <classifier>${pytorch.classifier}</classifier>
      <scope>runtime</scope>
    </dependency>

    <!-- DJL's JNI glue for this PyTorch version, bundled so nothing is downloaded at runtime -->
    <dependency>
      <groupId>ai.djl.pytorch</groupId>
      <artifactId>pytorch-jni</artifactId>
      <version>${pytorch.version}-${djl.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- DJL ONNX Runtime Engine (for ONNX models, e.g. emotion-ferplus). Excludes its own
         transitive onnxruntime (CPU) dependency — otherwise it stays on the classpath
         even under -Pgpu, alongside our explicit ${onnxruntime.artifact} above, putting
         both the CPU and CUDA native onnxruntime libraries in the same JVM at once. -->
    <dependency>
      <groupId>ai.djl.onnxruntime</groupId>
      <artifactId>onnxruntime-engine</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.microsoft.onnxruntime</groupId>
          <artifactId>onnxruntime</artifactId>
        </exclusion>
      </exclusions>
    </dependency>


    <!-- WebP decoding via TwelveMonkeys ImageIO -->
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
      <version>3.11.0</version>
    </dependency>

    <!-- SQLite JDBC for the enrolled-user store (face authentication) -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Maven Surefire Plugin for running tests -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>

      <!-- 2. Copy models to target/classes (will be included in JAR) -->
      <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
          <executions>
              <execution>
                  <id>copy-models-to-jar</id>
                  <phase>process-resources</phase>
                  <goals>
                      <goal>copy-resources</goal>
                  </goals>
                  <configuration>
                      <outputDirectory>${project.build.outputDirectory}/models</outputDirectory>
                      <resources>
                          <resource>
                              <directory>${models.directory}</directory>
                              <filtering>false</filtering>
                              <includes>
                                  <include>**/*.pt</include>
                                  <include>**/*.onnx</include>
                                  <include>**/*.torchscript</include>
                                  <include>**/*.traineddata</include>
                                  <include>**/*.json</include>
                              </includes>
                          </resource>
                      </resources>
                  </configuration>
              </execution>
          </executions>
      </plugin>

      <!-- 3. Ensure models are included in final JAR -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>

    <!-- Exclude models from default resource processing (we copy them explicitly) -->
    <resources>
        <resource>
            <directory>src/main/resources</directory>
            <excludes>
                <exclude>models/**</exclude>
            </excludes>
        </resource>
    </resources>
  </build>

  <!-- CPU vs GPU native artifact selection lives in the root pom's single gpu profile
       (pytorch.native.artifact / onnxruntime.artifact properties, consumed by the
       dependency declarations above) — see docs/configuration/gpu.md. Previously this
       module also declared its own gpu profile that *added* onnxruntime_gpu as an extra
       dependency alongside the always-present CPU onnxruntime jar, putting both native
       libraries on the classpath at once; that's removed now that the artifactId itself
       is switched by a property instead. -->
  <profiles>
    <!-- Optional profile to download bundled models at build time. Activate with -DdownloadModels=true or -Pdownload-models -->
    <profile>
      <id>download-models</id>
      <activation>
        <property>
          <name>downloadModels</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
              <groupId>io.github.download-maven-plugin</groupId>
              <artifactId>download-maven-plugin</artifactId>
              <version>2.0.0</version>
              <executions>
                  <!-- Tesseract language data (tesseract-ocr/tessdata_fast, Apache-2.0), pinned to
                       commit 87416418657359cb625c412a48b6e1d6d41c29bd and checked by SHA-256. -->
                  <execution>
                      <id>download-tessdata-eng</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/eng.traineddata</url>
                          <outputDirectory>${models.directory}/tessdata</outputDirectory>
                          <outputFileName>eng.traineddata</outputFileName>
                          <sha256>7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2</sha256>
                      </configuration>
                  </execution>
                  <execution>
                      <id>download-tessdata-nld</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/nld.traineddata</url>
                          <outputDirectory>${models.directory}/tessdata</outputDirectory>
                          <outputFileName>nld.traineddata</outputFileName>
                          <sha256>ced0e5e046a84c908a6aa7accbef9a232c4a5d9a8276691b81c6ee64d02963f6</sha256>
                      </configuration>
                  </execution>
                  <execution>
                      <id>download-tessdata-fra</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/fra.traineddata</url>
                          <outputDirectory>${models.directory}/tessdata</outputDirectory>
                          <outputFileName>fra.traineddata</outputFileName>
                          <sha256>ced037562e8c80c13122dece28dd477d399af80911a28791a66a63ac1e3445ca</sha256>
                      </configuration>
                  </execution>
                  <execution>
                      <id>download-tessdata-deu</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/deu.traineddata</url>
                          <outputDirectory>${models.directory}/tessdata</outputDirectory>
                          <outputFileName>deu.traineddata</outputFileName>
                          <sha256>19d219bbb6672c869d20a9636c6816a81eb9a71796cb93ebe0cb1530e2cdb22d</sha256>
                      </configuration>
                  </execution>
                  <execution>
                      <id>download-face-feature</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://github.com/codesapienbe/spring-vision/releases/download/v0.0.4/face_feature.zip</url>
                          <outputDirectory>${models.directory}/face_feature</outputDirectory>
                          <outputFileName>face_feature.zip</outputFileName>
                      </configuration>
                  </execution>
                  <!-- FER+ Emotion Detection Model (ONNX, 8 classes: neutral/happiness/surprise/sadness/anger/disgust/fear/contempt) -->
                  <execution>
                      <id>download-emotion-ferplus</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://github.com/codesapienbe/spring-vision/releases/download/v0.0.4/emotion-ferplus-8.onnx</url>
                          <outputDirectory>${models.directory}/emotion-ferplus</outputDirectory>
                          <outputFileName>emotion-ferplus-8.onnx</outputFileName>
                          <skipCache>false</skipCache>
                      </configuration>
                  </execution>
                  <!-- NSFW Detection Model (ViT fp16 ONNX, onnx-community/nsfw_image_detection-ONNX) -->
                  <!-- 2-class binary classifier: normal vs nsfw. Input 224x224. -->
                  <execution>
                      <id>download-nsfw-detection</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://github.com/codesapienbe/spring-vision/releases/download/v0.0.4/nsfw-detection-vit-fp16.onnx</url>
                          <outputDirectory>${models.directory}/nsfw-detection</outputDirectory>
                          <outputFileName>nsfw-detection-vit-fp16.onnx</outputFileName>
                          <skipCache>false</skipCache>
                      </configuration>
                  </execution>
                  <!-- Action Recognition Model (ViT fp16 ONNX, onnx-community/Human-Action-Recognition-VIT-Base-patch16-224-ONNX) -->
                  <!-- 15-class classifier: Calling, Clapping, Cycling, Dancing, Drinking, Eating, Fighting, Hugging,
                       Laughing, Listening Music, Running, Sitting, Sleeping, Texting, Using Laptop. Input 224x224. -->
                  <execution>
                      <id>download-action-recognition</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://github.com/codesapienbe/spring-vision/releases/download/v0.0.4/action-recognition-vit-fp16.onnx</url>
                          <outputDirectory>${models.directory}/action-recognition</outputDirectory>
                          <outputFileName>action-recognition-vit-fp16.onnx</outputFileName>
                          <skipCache>false</skipCache>
                      </configuration>
                  </execution>
                  <!-- Hand Detection Model (MediaPipe Palm Detector ONNX, from opencv/palm_detection_mediapipe) -->
                  <!-- Anchor-based palm detector; 3.7 MB; outputs (1, 2016, 18) box+landmark deltas and (1, 2016, 1) score logits. -->
                  <execution>
                      <id>download-palm-detection</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://github.com/codesapienbe/spring-vision/releases/download/v0.0.4/palm_detection_mediapipe.onnx</url>
                          <outputDirectory>${models.directory}/palm-detection</outputDirectory>
                          <outputFileName>palm_detection_mediapipe.onnx</outputFileName>
                          <skipCache>false</skipCache>
                      </configuration>
                  </execution>
                  <!-- Deepfake Detection Model (ViT fp16 ONNX, onnx-community/Deep-Fake-Detector-v2-Model-ONNX) -->
                  <execution>
                      <id>download-deepfake-detector</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://github.com/codesapienbe/spring-vision/releases/download/v0.0.4/deepfake-detector-fp16.onnx</url>
                          <outputDirectory>${models.directory}/deepfake-detector</outputDirectory>
                          <outputFileName>deepfake-detector-fp16.onnx</outputFileName>
                          <skipCache>false</skipCache>
                      </configuration>
                  </execution>
                  <!-- Age/Gender Demographics Models (ONNX, GoogLeNet-based from ONNX Model Zoo) -->
                  <execution>
                      <id>download-age-googlenet</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://github.com/codesapienbe/spring-vision/releases/download/v0.0.4/age_googlenet.onnx</url>
                          <outputDirectory>${models.directory}/age-gender</outputDirectory>
                          <outputFileName>age_googlenet.onnx</outputFileName>
                          <skipCache>false</skipCache>
                      </configuration>
                  </execution>
                  <execution>
                      <id>download-gender-googlenet</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>wget</goal>
                      </goals>
                      <configuration>
                          <url>https://github.com/codesapienbe/spring-vision/releases/download/v0.0.4/gender_googlenet.onnx</url>
                          <outputDirectory>${models.directory}/age-gender</outputDirectory>
                          <outputFileName>gender_googlenet.onnx</outputFileName>
                          <skipCache>false</skipCache>
                      </configuration>
                  </execution>
              </executions>
          </plugin>
          <!-- Maven Antrun Plugin for extracting ZIP files -->
          <plugin>
              <artifactId>maven-antrun-plugin</artifactId>
              <version>3.1.0</version>
              <executions>
                  <execution>
                      <id>extract-face-feature</id>
                      <phase>generate-resources</phase>
                      <goals>
                          <goal>run</goal>
                      </goals>
                      <configuration>
                          <target>
                              <unzip src="${models.directory}/face_feature/face_feature.zip"
                                     dest="${models.directory}/face_feature" />
                          </target>
                      </configuration>
                  </execution>
              </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
